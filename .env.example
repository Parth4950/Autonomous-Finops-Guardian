# AWS credentials — required for connectivity verification (test_aws.py)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_REGION=ap-south-1

# Database — local SQLite is the default; set DATABASE_URL for Railway PostgreSQL.
DATABASE_URL=

# Authentication — required on Railway/production; leave blank only for local development.
AUTH_SECRET_KEY=

# Credential encryption — URL-safe base64 32-byte key required for storing AWS account credentials.
CREDENTIALS_ENCRYPTION_KEY=

# Gemini — required for AI-generated risk explanations (Risk Assessor agent)
GEMINI_API_KEY=

# Executor — simulation (default) or real AWS execution (future)
EXECUTION_MODE=simulation

# Hosted deploy (Render) — comma-separated frontend origins (Vercel URL)
# CORS_ALLOW_ORIGINS=https://your-app.vercel.app
ALLOW_AWS_SCAN=false
